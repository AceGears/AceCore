 // this will simulate an x86_64 version of the function (no tracking will done, but tracking will be used)
 void* box_mmap(void* addr, size_t length, int prot, int flags, int fd, ssize_t offset);
+// Native mprotect for guest memory. Guest x86 code is translated, never executed natively, so when the host refuses
+// PROT_EXEC (Android apps targeting API 29+: SELinux denies "execmod" on modified file-backed pages), the protection
+// is applied without it; box64 keeps tracking the guest's PROT_EXEC itself.
+int box_mprotect(void* addr, size_t len, int prot);
 // this will simulate an x86_64 version of the function (no tracking will done)
 int box_munmap(void* addr, size_t length);
 
